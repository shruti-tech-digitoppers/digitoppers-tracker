# DigiTopper Project Tracker - Backend Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your Atlas or Local URI)
MONGODB_URI=mongodb://localhost:27017/digitoppers_db

# Security & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000

# Core Backend LMS/DG API Integration
CORE_BACKEND_URL=http://localhost:3001
INTERNAL_SERVICE_SECRET=tracker_core_shared_secret_2026

# Slack Integration (Dedicated Channel #digitoppers-project-tracker with Assigned Member @mentions)
SLACK_WEBHOOK_URL=https://your-slack-incoming-webhook-url-here
SLACK_CHANNEL=#digitoppers-project-tracker
# Optional: Slack Bot Token (xoxb-...) to auto-lookup employee Slack Member IDs by email
SLACK_BOT_TOKEN=

